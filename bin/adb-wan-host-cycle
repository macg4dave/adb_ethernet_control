#!/usr/bin/env bash
# Executed by a local system service. Never changes phone USB functions.
set -euo pipefail
: "${WAN_INTERFACE:?Set WAN_INTERFACE}"
: "${PHONE_SERIAL:?Set PHONE_SERIAL}"
: "${WAN_CONNECTION_UUID:?Set WAN_CONNECTION_UUID}"
[[ "$WAN_INTERFACE" =~ ^[a-zA-Z0-9._:-]+$ ]] || exit 1
[[ "$WAN_CONNECTION_UUID" =~ ^[a-fA-F0-9-]{36}$ ]] || exit 1
outage_delay=${OUTAGE_DELAY:-5}
settle_delay=${POST_ENABLE_DELAY:-20}
for value in "$outage_delay" "$settle_delay"; do
    [[ "$value" =~ ^[1-9][0-9]{0,2}$ ]] || exit 1
done
recovery_bin=${RECOVERY_BIN:-$(dirname -- "${BASH_SOURCE[0]}")/adb-wan-recover}
adb_bin=${ADB_BIN:-adb}
adb_port=${ADB_SERVER_PORT:-5037}
log() { printf '%s host-cycle: %s\n' "$(date -u +%FT%TZ)" "$*"; }
phone_state() { timeout --kill-after=2s 10s "$adb_bin" -P "$adb_port" -s "$PHONE_SERIAL" shell -T -n getprop sys.usb.state; }
active_uuid() { nmcli --wait 10 -g GENERAL.CON-UUID device show "$WAN_INTERFACE"; }
[[ $(active_uuid) == "$WAN_CONNECTION_UUID" ]] || { log 'Selected profile is not active on this interface.'; exit 1; }
driver=$(nmcli --wait 10 -g GENERAL.DRIVER device show "$WAN_INTERFACE")
case "$driver" in rndis_host|cdc_ncm) ;; *) log "Unsupported phone WAN driver: $driver"; exit 1 ;; esac
before=$(phone_state)
[[ ",$before," == *,adb,* && ( ",$before," == *,rndis,* || ",$before," == *,ncm,* ) ]] || exit 1
log 'Checking a healthy WAN baseline.'
USB_CYCLE_ENABLED=0 "$recovery_bin" --check

fallback="adb-wan-host-fallback-$BASHPID"
pending=false
cancel_fallback() { systemctl stop "$fallback.timer"; }
restore() { nmcli --wait 60 connection up uuid "$WAN_CONNECTION_UUID" ifname "$WAN_INTERFACE"; }
# Invoked by EXIT, independently of chat or the terminal.
# shellcheck disable=SC2317
cleanup() {
    if "$pending"; then
        log 'Final local restore attempt; independent fallback remains armed until restoration succeeds.'
        if restore; then cancel_fallback || true; else log 'Restore failed; leaving the fallback timer armed.'; fi
    fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP
# This separate system timer survives termination of this coordinator.
log 'Arming a separate 60-second systemd restore timer before taking WAN down.'
systemd-run --unit="$fallback" --collect --on-active=60s \
    --timer-property=AccuracySec=1s /usr/bin/nmcli --wait 60 \
    connection up uuid "$WAN_CONNECTION_UUID" ifname "$WAN_INTERFACE"
pending=true
log "Deactivating only profile $WAN_CONNECTION_UUID on $WAN_INTERFACE."
nmcli --wait 15 connection down uuid "$WAN_CONNECTION_UUID"
[[ $(active_uuid) != "$WAN_CONNECTION_UUID" ]] || { log 'Outage was not observed.'; exit 1; }
[[ $(phone_state) == "$before" ]] || { log 'ADB/USB state changed unexpectedly.'; exit 1; }
log "Host-side outage observed; ADB and USB state unchanged. Holding for ${outage_delay}s."
sleep "$outage_delay"
log 'Reactivating the same NetworkManager profile and waiting for DHCP.'
restore
[[ $(active_uuid) == "$WAN_CONNECTION_UUID" ]] || exit 1
cancel_fallback
pending=false
log "Profile restored; allowing ${settle_delay}s for WAN to settle."
sleep "$settle_delay"
STARTUP_DELAY=1 HEALTH_GRACE=60 USB_CYCLE_ENABLED=0 "$recovery_bin" --check
[[ $(phone_state) == "$before" ]] || { log 'Phone USB state differs from baseline.'; exit 1; }
log 'PASS: host outage observed, profile restored, WAN healthy, phone USB state unchanged.'
