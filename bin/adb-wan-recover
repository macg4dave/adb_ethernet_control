#!/usr/bin/env bash
# Bounded boot-time recovery of a USB phone WAN. Configuration is environment-only.
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: adb-wan-recover --check|--recover|--test-cycle

--check    Wait for startup and check WAN; never change USB functions.
--recover  If WAN remains down and USB networking is enabled, cycle it once.
--test-cycle  Explicit manual hardware test: require healthy WAN, then cycle once.

Required environment: PHONE_SERIAL, WAN_INTERFACE.
See docs/boot-recovery.md and config/wan-recovery.env.example.
Exit: 0 healthy, 1 configuration/control failure, 2 WAN unhealthy or not restored.
EOF
}
log() { printf 'adb-wan-recover: %s\n' "$*"; }
die() { log "$*" >&2; exit 1; }
mode=${1:-}
case "$mode" in
    -h|--help) usage; exit 0 ;;
    --check|--recover|--test-cycle) (($# == 1)) || die 'specify one mode' ;;
    *) usage >&2; exit 1 ;;
esac

: "${PHONE_SERIAL:?Set PHONE_SERIAL to the authorized USB phone serial}"
: "${WAN_INTERFACE:?Set WAN_INTERFACE to the phone host network interface}"
[[ "$PHONE_SERIAL" =~ ^[a-zA-Z0-9._:-]+$ ]] || die 'invalid PHONE_SERIAL'
[[ "$WAN_INTERFACE" =~ ^[a-zA-Z0-9._:-]+$ ]] || die 'invalid WAN_INTERFACE'
ADB_BIN=${ADB_BIN:-adb}
ADB_SERVER_PORT=${ADB_SERVER_PORT:-5037}
ADB_TIMEOUT=${ADB_TIMEOUT:-10}
READY_UNITS=${READY_UNITS:-NetworkManager.service}
READINESS_TIMEOUT=${READINESS_TIMEOUT:-120}
PHONE_TIMEOUT=${PHONE_TIMEOUT:-60}
STARTUP_DELAY=${STARTUP_DELAY:-15}
HEALTH_GRACE=${HEALTH_GRACE:-45}
RECOVERY_TIMEOUT=${RECOVERY_TIMEOUT:-60}
POLL_INTERVAL=${POLL_INTERVAL:-3}
OFF_DELAY=${OFF_DELAY:-1}
POST_ENABLE_DELAY=${POST_ENABLE_DELAY:-20}
USB_CYCLE_ENABLED=${USB_CYCLE_ENABLED:-0}
[[ "$USB_CYCLE_ENABLED" == 0 || "$USB_CYCLE_ENABLED" == 1 ]] || die 'USB_CYCLE_ENABLED must be 0 or 1'
PROBE_TIMEOUT=${PROBE_TIMEOUT:-5}
PROBE_URLS=${PROBE_URLS:-https://1.1.1.1/cdn-cgi/trace https://1.0.0.1/cdn-cgi/trace}
if [[ -w /run/adb-wan-recover ]]; then
    LOCK_FILE=${LOCK_FILE:-/run/adb-wan-recover/recovery.lock}
else
    LOCK_FILE=${LOCK_FILE:-${XDG_RUNTIME_DIR:-/run/user/$UID}/adb-wan-recover.lock}
fi
for name in ADB_SERVER_PORT ADB_TIMEOUT READINESS_TIMEOUT PHONE_TIMEOUT STARTUP_DELAY HEALTH_GRACE RECOVERY_TIMEOUT POLL_INTERVAL OFF_DELAY POST_ENABLE_DELAY PROBE_TIMEOUT; do
    [[ "${!name}" =~ ^[1-9][0-9]*$ ]] || die "$name must be a positive integer"
done
((ADB_SERVER_PORT <= 65535)) || die 'invalid ADB_SERVER_PORT'
for tool in "$ADB_BIN" timeout curl ip systemctl flock; do
    command -v "$tool" >/dev/null || die "missing executable: $tool"
done
read -r -a ready_units <<< "$READY_UNITS"
read -r -a probe_urls <<< "$PROBE_URLS"
((${#ready_units[@]} > 0)) || die 'READY_UNITS must list at least one service'
((${#probe_urls[@]} > 0)) || die 'PROBE_URLS must list at least one endpoint'
for unit in "${ready_units[@]}"; do
    [[ "$unit" =~ ^[a-zA-Z0-9_.@:-]+\.service$ ]] || die "invalid readiness unit: $unit"
done
for url in "${probe_urls[@]}"; do
    [[ "$url" == https://* ]] || die 'WAN probes must use HTTPS'
done
exec 9> "$LOCK_FILE"
flock -n 9 || die 'another recovery/check process is running'

adb_run() { timeout --kill-after=2s "${ADB_TIMEOUT}s" "$ADB_BIN" -P "$ADB_SERVER_PORT" "$@"; }
phone() { adb_run -s "$PHONE_SERIAL" shell -T -n "$@"; }
# Called indirectly by wait_until.
# shellcheck disable=SC2317
ready() {
    local unit
    for unit in "${ready_units[@]}"; do
        timeout --kill-after=2s 5s systemctl is-active --quiet "$unit" || return 1
    done
    return 0
}
# shellcheck disable=SC2317
authorized_usb() {
    local listing id state details
    listing=$(adb_run devices -l) || return 1
    while read -r id state details; do
        if [[ "$id" == "$PHONE_SERIAL" && "$state" == device && " $details " == *' usb:'* ]]; then
            return 0
        fi
    done <<< "$listing"
    return 1
}
healthy() {
    local url code
    # Binding probes prevents another WAN or a proxy from hiding phone failure.
    ip -4 -o address show dev "$WAN_INTERFACE" scope global 2>/dev/null | grep -q ' inet ' || return 1
    for url in "${probe_urls[@]}"; do
        code=$(curl --disable --ipv4 --noproxy '*' --interface "$WAN_INTERFACE" \
            --silent --output /dev/null --write-out '%{http_code}' \
            --connect-timeout "$PROBE_TIMEOUT" --max-time "$PROBE_TIMEOUT" "$url") || continue
        [[ "$code" == 200 ]] && return 0
    done
    return 1
}
wait_until() {
    local label=$1 budget=$2 deadline
    shift 2
    deadline=$((SECONDS + budget))
    log "Waiting for $label (up to ${budget}s plus in-flight probe time)."
    while true; do
        if "$@"; then return 0; fi
        ((SECONDS < deadline)) || return 1
        sleep "$POLL_INTERVAL"
    done
}

wait_until 'host services' "$READINESS_TIMEOUT" ready || die "required services not active: $READY_UNITS"
log "Startup settling delay: ${STARTUP_DELAY}s."
sleep "$STARTUP_DELAY"
if wait_until 'phone WAN connectivity' "$HEALTH_GRACE" healthy; then
    if [[ "$mode" == --test-cycle ]]; then
        log 'Healthy WAN baseline verified; proceeding with explicitly requested hardware test.'
    else
        log 'WAN healthy; no changes needed.'
        exit 0
    fi
elif [[ "$mode" == --test-cycle ]]; then
    log 'Test requires a healthy WAN baseline; no changes made.'
    exit 2
fi
if [[ "$mode" == --check ]]; then
    log 'WAN unhealthy; check mode made no changes.'
    exit 2
fi
[[ "$USB_CYCLE_ENABLED" == 1 ]] || die 'USB cycling disabled: live HONOR tests required manual restoration; diagnostic checks remain available'
wait_until 'authorized USB phone' "$PHONE_TIMEOUT" authorized_usb || die 'phone absent, unauthorized, offline, or not USB; no toggle performed'
state=$(phone getprop sys.usb.state) || die 'cannot read phone USB state; no toggle performed'
state=${state//$'\r'/}
case ",$state," in
    *,rndis,*) function=rndis ;;
    *,ncm,*) function=ncm ;;
    *) die "USB networking not enabled (state=$state); no toggle performed" ;;
esac
[[ ",$state," == *,adb,* ]] || die 'USB state does not include ADB; refusing to risk losing control'
[[ "$state" == "$function,adb" || "$state" == "adb,$function" ]] || die "unsupported combined USB state ($state); no toggle performed"
# Check again immediately before disruption: networking may have recovered.
if [[ "$mode" != --test-cycle ]] && healthy; then
    log 'WAN recovered before toggle; no changes needed.'
    exit 0
fi

# Confirm the phone can run a detached restore before touching USB functions.
phone 'command -v nohup >/dev/null && command -v setsid >/dev/null && test -w /data/local/tmp' || die 'phone cannot run detached USB recovery; no toggle performed'
cycle_id="$BASHPID-$RANDOM"
cycle_body=$(cat <<'PHONE'
echo cycle_id=__CYCLE_ID__
svc usb setFunctions
sleep __OFF_DELAY__
echo off_state=$(getprop sys.usb.state)
svc usb setFunctions __FUNCTION__
restore_exit=$?
echo restore_exit=$restore_exit
PHONE
)
cycle_body=${cycle_body//__CYCLE_ID__/$cycle_id}
cycle_body=${cycle_body//__OFF_DELAY__/$OFF_DELAY}
cycle_body=${cycle_body//__FUNCTION__/$function}
remote_log=/data/local/tmp/adb-wan-cycle.log
restore_pending=true
# Called by the EXIT trap.
# shellcheck disable=SC2317
cleanup() {
    if "$restore_pending"; then
        log "Attempting final best-effort restore of $function."
        phone svc usb setFunctions "$function" || log 'Restore failed; manual phone intervention may be required.'
    fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP
log "Mode $mode: performing one USB networking cycle ($function)."
# Both commands run on the phone: this model loses ADB while USB networking is off.
# The body contains only fixed commands and validated integer/enum substitutions.
phone "umask 077; command nohup setsid sh -c '$cycle_body' >$remote_log 2>&1 </dev/null &" || log 'Cycle launch response lost; waiting for the detached phone worker.'
wait_until 'ADB after phone-side USB cycle' "$PHONE_TIMEOUT" authorized_usb || die 'ADB did not return after phone-side restore'
cycle_log=''
# shellcheck disable=SC2317
worker_finished() {
    cycle_log=$(phone "cat $remote_log") || return 1
    [[ $'\n'"$cycle_log"$'\n' == *$'\n'"cycle_id=$cycle_id"$'\n'* && $'\n'"$cycle_log"$'\n' == *$'\n'restore_exit=*$'\n'* ]]
}
wait_until 'phone-side restore completion' "$PHONE_TIMEOUT" worker_finished || die 'no completed restore record from phone worker'
[[ $'\n'"$cycle_log"$'\n' == *$'\n'restore_exit=0$'\n'* ]] || die 'phone-side USB restore command failed'
restore_pending=false
off_verified=false
while IFS= read -r record; do
    [[ "$record" == off_state=* ]] || continue
    off_state=${record#off_state=}
    off_state=${off_state//$'\r'/}
    if [[ -n "$off_state" && ",$off_state," != *",$function,"* ]]; then
        off_verified=true
        log "USB networking off state observed: $off_state."
    else
        log "USB networking off state not observed (state=$off_state)."
    fi
done <<< "$cycle_log"
log "USB restored; allowing ${POST_ENABLE_DELAY}s for phone tethering and host DHCP to settle."
sleep "$POST_ENABLE_DELAY"
if wait_until 'restored WAN connectivity' "$RECOVERY_TIMEOUT" healthy; then
    if [[ "$mode" == --test-cycle ]] && ! "$off_verified"; then
        die 'WAN healthy, but USB-off state was not verified; hardware test inconclusive'
    fi
    if "$off_verified"; then
        log 'WAN restored after one USB networking cycle.'
    else
        log 'WAN healthy after recovery attempt; USB-off state was not verified.'
    fi
    exit 0
fi
log 'WAN still unhealthy after one cycle; stopping without further toggles.'
exit 2
