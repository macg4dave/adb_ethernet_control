#!/usr/bin/env bash
# One boot recovery attempt; phone commands always select the configured USB phone.
set -euo pipefail
mode=${1:---boot}
[[ ( $# -le 1 && ( "$mode" == --boot || "$mode" == --test-usb-toggle ) ) || ( $# -eq 2 && "$mode" == --restore && ( "$2" == rndis || "$2" == ncm ) ) ]] || exit 1
manual_test=false
if [[ "$mode" == --test-usb-toggle ]]; then manual_test=true; fi
: "${WAN_INTERFACE:?Set WAN_INTERFACE}"
[[ "$WAN_INTERFACE" =~ ^[a-zA-Z0-9._:-]+$ ]] || exit 1
ADB_BIN=${ADB_BIN:-adb}
ADB_SERVER_PORT=${ADB_SERVER_PORT:-5038}
ADB_TIMEOUT=${ADB_TIMEOUT:-10}
PHONE_TIMEOUT=${PHONE_TIMEOUT:-60}
READY_UNITS=${READY_UNITS:-NetworkManager.service}
READINESS_TIMEOUT=${READINESS_TIMEOUT:-120}
STARTUP_DELAY=${STARTUP_DELAY:-15}
POLL_INTERVAL=${POLL_INTERVAL:-3}
PROBE_TIMEOUT=${PROBE_TIMEOUT:-5}
POST_ENABLE_DELAY=${POST_ENABLE_DELAY:-20}
CONNECTION_TIMEOUT=${CONNECTION_TIMEOUT:-45}
USB_FUNCTION=${USB_FUNCTION:-rndis}
if [[ "$mode" == --restore ]]; then USB_FUNCTION=$2; fi
USB_CYCLE_ENABLED=${USB_CYCLE_ENABLED:-0}
BOOT_ENV_FILE=${BOOT_ENV_FILE:-/etc/adb-ethernet-control/boot.env}
[[ "$USB_FUNCTION" == rndis || "$USB_FUNCTION" == ncm ]] || exit 1
[[ "$USB_CYCLE_ENABLED" == 0 || "$USB_CYCLE_ENABLED" == 1 ]] || exit 1
for name in ADB_SERVER_PORT ADB_TIMEOUT PHONE_TIMEOUT READINESS_TIMEOUT STARTUP_DELAY POLL_INTERVAL PROBE_TIMEOUT POST_ENABLE_DELAY CONNECTION_TIMEOUT; do
    [[ "${!name}" =~ ^[1-9][0-9]{0,3}$ ]] || exit 1
done
((ADB_SERVER_PORT <= 65535)) || exit 1
for tool in systemctl timeout ping ip flock; do command -v "$tool" >/dev/null; done
read -r -a units <<< "$READY_UNITS"
((${#units[@]})) || exit 1
for unit in "${units[@]}"; do [[ "$unit" =~ ^[a-zA-Z0-9_.@:-]+\.service$ ]] || exit 1; done
log() { printf '%s boot-wan: %s\n' "$(date -u +%FT%TZ)" "$*"; }
fail() { log "ERROR: $*"; exit 1; }
# Called indirectly by wait_for.
# shellcheck disable=SC2317
ready() {
    local unit
    for unit in "${units[@]}"; do timeout --kill-after=2s 5s systemctl is-active --quiet "$unit" || return 1; done
}
# Called indirectly by wait_for as well as healthy.
host_connected() {
    timeout --kill-after=2s 5s ip -4 -o address show dev "$WAN_INTERFACE" scope global 2>/dev/null | grep -q ' inet ' || return 1
}
healthy() {
    host_connected || return 1
    timeout --kill-after=2s "${PROBE_TIMEOUT}s" ping -4 -n -I "$WAN_INTERFACE" \
        -c 1 -W "$PROBE_TIMEOUT" 8.8.8.8 >/dev/null 2>&1
}
wait_for() {
    local budget=$1 deadline
    shift
    deadline=$((SECONDS + budget))
    until "$@"; do
        ((SECONDS < deadline)) || return 1
        sleep "$POLL_INTERVAL"
    done
}
adb_run() {
    local server_args=()
    # An explicit host prevents ADB from auto-spawning a root-owned server while
    # systemd's user-owned server is still opening its listener.
    if [[ -n ${ADB_SERVER_UNIT-adb-wan-server.service} ]]; then server_args=(-H 127.0.0.1); fi
    timeout --kill-after=2s "${ADB_TIMEOUT}s" "$ADB_BIN" "${server_args[@]}" -P "$ADB_SERVER_PORT" "$@"
}
# Resolve a USB transport ID afresh after every re-enumeration. Never fall back to TCP.
# shellcheck disable=SC2317
select_phone() {
    local listing serial state details token found=0
    transport=''
    phone_problem='configured phone absent'
    listing=$(adb_run devices -l) || { phone_problem='ADB discovery failed'; return 1; }
    while read -r serial state details; do
        [[ "$serial" == "$PHONE_SERIAL" ]] || continue
        phone_problem="configured phone is $state or is not a USB transport"
        [[ "$state" == device && " $details " == *' usb:'* ]] || continue
        for token in $details; do
            if [[ "$token" =~ ^transport_id:([0-9]+)$ ]]; then
                transport=${BASH_REMATCH[1]}
                found=$((found + 1))
            fi
        done
    done <<< "$listing"
    [[ "$found" == 1 ]] || { phone_problem='phone absent, unauthorized, offline, non-USB, or ambiguous'; return 1; }
}
phone() {
    select_phone || return 1
    adb_run -t "$transport" shell -T -n "$@"
}
# Vendors add functions (HONOR boots as hisuite,mtp,mass_storage,adb), so judge the set.
# Called indirectly by wait_for.
# shellcheck disable=SC2317
usb_state() {
    local state fn adb=false net=''
    state=$(phone getprop sys.usb.state) || { phone_problem='USB state read failed'; return 1; }
    state=${state//$'\r'/}
    [[ "$state" =~ ^[a-z0-9_]+(,[a-z0-9_]+)*$ ]] || { phone_problem='malformed or empty USB state'; return 1; }
    for fn in ${state//,/ }; do
        case "$fn" in
            adb) adb=true ;;
            rndis|ncm) [[ -z "$net" ]] || { phone_problem="ambiguous USB state $state"; return 1; }; net=$fn ;;
        esac
    done
    "$adb" || { phone_problem="ADB function missing from USB state $state"; return 1; }
    if [[ -n "$net" ]]; then usb=on; USB_FUNCTION=$net; else usb=off; fi
    usb_raw=$state
}
enable_usb() {
    # svc manages ADB separately; never request adb in its setFunctions mask.
    phone svc usb setFunctions "$USB_FUNCTION"
}
prepare_adb() {
    [[ ${PHONE_SERIAL:-} =~ ^[a-zA-Z0-9._:-]+$ ]] || fail 'Set PHONE_SERIAL to the pinned USB phone.'
    command -v "$ADB_BIN" >/dev/null || fail 'ADB executable unavailable.'
    local server_unit=${ADB_SERVER_UNIT-adb-wan-server.service}
    if [[ -n "$server_unit" ]]; then
        [[ "$server_unit" =~ ^[a-zA-Z0-9_.@:-]+\.service$ ]] || fail 'Invalid ADB server unit.'
        log 'Starting dedicated ADB server; waiting for authorized USB transport.'
        timeout --kill-after=2s 15s systemctl start "$server_unit" || fail 'Dedicated ADB server failed to start.'
    fi
    wait_for "$PHONE_TIMEOUT" select_phone || fail "$phone_problem; no USB changes made."
}
if [[ "$mode" == --restore ]]; then
    # Independent systemd fallback: no coordinator lock and no off command.
    prepare_adb
    wait_for "$PHONE_TIMEOUT" usb_state || fail "Fallback cannot read USB state: $phone_problem."
    if [[ "$usb" == off ]]; then enable_usb || fail 'Fallback enable command failed.'; fi
    log 'Independent restore finished; USB Ethernet enable requested if needed.'
    exit 0
fi
if "$manual_test"; then
    # Reject accidental direct execution: the system manager must own this process.
    [[ ${TEST_SYSTEMD_UNIT:-} =~ ^[a-zA-Z0-9_.@:-]+$ ]] || fail 'Launch manual tests through scripts/start-local-check --test-usb-toggle.'
    cgroup=$(timeout --kill-after=2s 5s systemctl show "$TEST_SYSTEMD_UNIT.service" --property=ControlGroup --value) || fail 'Cannot verify system supervision.'
    [[ -n "$cgroup" && $'\n'"$(cat /proc/self/cgroup)"$'\n' == *":$cgroup"$'\n'* ]] || fail 'Manual test is not in the configured system service.'
fi
exec 9> "${LOCK_FILE:-/run/adb-wan-recover/recovery.lock}"
flock -n 9 || exit 1
wait_for "$READINESS_TIMEOUT" ready || fail 'Host services not ready.'
sleep "$STARTUP_DELAY"
if healthy; then
    if "$manual_test"; then log 'Healthy WAN baseline verified for explicitly requested USB toggle test.'
    else log 'WAN healthy; no changes needed.'; exit 0; fi
elif "$manual_test"; then
    fail 'Manual USB toggle test requires a healthy WAN baseline; no changes made.'
fi
log 'WAN unavailable after startup; inspecting phone USB Ethernet.'
prepare_adb
wait_for "$PHONE_TIMEOUT" usb_state || fail "Cannot establish phone USB Ethernet state: $phone_problem; no USB changes made."
log "Observed USB Ethernet: $usb ($usb_raw)."
if "$manual_test" && [[ "$usb" != on ]]; then fail 'Manual USB toggle test requires USB Ethernet on; no changes made.'; fi
# Catch connectivity returning while ADB becomes ready.
if ! "$manual_test" && healthy; then log 'WAN recovered before USB changes; no changes needed.'; exit 0; fi
pending=false
recovery_requested=false
off_verified=false
fallback="adb-wan-usb-restore-$BASHPID"
# Called by EXIT; leave the independent restore armed if confirmation is unavailable.
# shellcheck disable=SC2317
cleanup() {
    if "$pending"; then
        if usb_state && [[ "$usb" == off ]]; then enable_usb || true; fi
    fi
}
trap cleanup EXIT
trap 'exit 143' TERM HUP
trap 'exit 130' INT
if [[ "$usb" == off ]]; then
    log "USB Ethernet off; enabling $USB_FUNCTION once."
    recovery_requested=true
    enable_usb || log 'Enable response failed or was lost; checking actual WAN state.'
elif "$manual_test" || [[ "$USB_CYCLE_ENABLED" == 1 ]]; then
    # The explicit manual test is separate from the automatic recovery gate.
    command -v systemd-run >/dev/null || fail 'systemd-run unavailable; no USB changes made.'
    if "$manual_test"; then
        restore_env=(--setenv="WAN_INTERFACE=$WAN_INTERFACE" --setenv="PHONE_SERIAL=$PHONE_SERIAL"
            --setenv=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
            --setenv="ADB_BIN=$ADB_BIN" --setenv="ADB_SERVER_PORT=$ADB_SERVER_PORT"
            --setenv="ADB_TIMEOUT=$ADB_TIMEOUT" --setenv="PHONE_TIMEOUT=$PHONE_TIMEOUT"
            --setenv="POLL_INTERVAL=$POLL_INTERVAL" --setenv="ADB_SERVER_UNIT=${ADB_SERVER_UNIT-adb-wan-server.service}")
    else
        [[ "$BOOT_ENV_FILE" == /* && -r "$BOOT_ENV_FILE" ]] || fail 'Restore environment unavailable; no USB changes made.'
        restore_env=(--property="EnvironmentFile=$BOOT_ENV_FILE")
    fi
    log 'Arming independent restore before one USB Ethernet off/on cycle.'
    timeout --kill-after=2s 15s systemd-run --unit="$fallback" --collect --on-active=30s \
        --timer-property=AccuracySec=1s "${restore_env[@]}" \
        --property=TimeoutStartSec=100s --property=RuntimeMaxSec=100s \
        "$(readlink -f -- "${BASH_SOURCE[0]}")" --restore "$USB_FUNCTION" || fail 'Cannot arm restore timer; no USB changes made.'
    pending=true
    if ! "$manual_test" && healthy; then
        timeout --kill-after=2s 5s systemctl stop "$fallback.timer" || true
        pending=false
        log 'WAN recovered while restore timer was armed; no USB changes needed.'
        exit 0
    fi
    # A non-network USB function avoids requesting charging-only mode. Vendor behavior
    # and continued ADB access still require hardware verification before enabling.
    recovery_requested=true
    phone svc usb setFunctions mtp || log 'Off response failed or was lost; proceeding to restore.'
    sleep 1
    if wait_for "$PHONE_TIMEOUT" select_phone; then
        if usb_state && [[ "$usb" == off ]]; then
            off_verified=true
            log 'USB Ethernet off state observed.'
        else
            log 'USB Ethernet off state was not observed; restoring original networking function.'
        fi
        enable_usb || log 'On response failed or was lost; independent restore remains armed.'
    else
        log 'ADB did not return; independent restore remains armed.'
    fi
else
    log 'USB cycle skipped: independent phone restoration has not been verified.'
fi
if "$recovery_requested"; then
    log "Waiting ${POST_ENABLE_DELAY}s for phone tethering, then up to ${CONNECTION_TIMEOUT}s for host IPv4 on $WAN_INTERFACE."
    sleep "$POST_ENABLE_DELAY"
    wait_for "$CONNECTION_TIMEOUT" host_connected || log 'Host IPv4 connection not ready; continuing to final WAN checks.'
fi
log 'Checking WAN after recovery decision.'
healthy && first=healthy || first=unhealthy
log "First WAN check: $first; waiting 10 seconds before final WAN check."
sleep 10
if "$manual_test"; then
    healthy && wan_result=healthy || wan_result=unavailable
    usb=unknown
    usb_state || usb=unknown
    if [[ "$usb" == on ]]; then
        timeout --kill-after=2s 5s systemctl stop "$fallback.timer" || true
        pending=false
    fi
    if "$off_verified" && [[ "$usb" == on ]]; then
        log "PASS: USB Ethernet off and on states verified; WAN $wan_result (informational)."
        exit 0
    fi
    log "ERROR: USB toggle not verified (off_observed=$off_verified, final_usb=$usb); WAN $wan_result (informational)."
    exit 1
fi
if healthy; then
    if "$pending" && usb_state && [[ "$usb" == on ]]; then
        timeout --kill-after=2s 5s systemctl stop "$fallback.timer" || true
        pending=false
    fi
    log 'WAN healthy after boot recovery checks.'
    exit 0
fi
usb=unknown
usb_state || usb=unknown
# One final error; never start another cycle or automatically restart the service.
log "ERROR: USB Ethernet $usb but WAN unavailable after final check; stopping."
exit 2
