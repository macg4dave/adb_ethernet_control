# Copy to /etc/adb-ethernet-control/wan-recovery.env and set your phone serial.
PHONE_SERIAL=REPLACE_WITH_USB_SERIAL
WAN_INTERFACE=enp48s0f4u2
ADB_BIN=/usr/local/bin/adb
ADB_LIBUSB=1
# Dedicated server for boot recovery. Manual commands using this file use it too.
ADB_SERVER_PORT=5038
# Active services gate recovery; add your actual LAN DHCP/DNS service here.
READY_UNITS="NetworkManager.service pc101-technitium.service"
READINESS_TIMEOUT=120
PHONE_TIMEOUT=60
STARTUP_DELAY=15
HEALTH_GRACE=45
RECOVERY_TIMEOUT=60
POLL_INTERVAL=3
OFF_DELAY=3
POST_ENABLE_DELAY=20
# Both live HONOR cycles required manual restoration. Keep disabled until fixed.
USB_CYCLE_ENABLED=0
PROBE_TIMEOUT=5
# A 200 response from either HTTPS endpoint counts as WAN reachability.
PROBE_URLS="https://1.1.1.1/cdn-cgi/trace https://1.0.0.1/cdn-cgi/trace"
