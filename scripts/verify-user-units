#!/usr/bin/env bash
# Some systemd versions replace the user manager's private socket during verify.
# Never let the verifier use the login session's runtime directory or buses.
set -euo pipefail
(($#)) || { printf 'Usage: verify-user-units UNIT...\n' >&2; exit 1; }
scratch=$(mktemp -d)
trap 'rm -rf -- "$scratch"' EXIT
mkdir -m700 "$scratch/runtime" "$scratch/config" "$scratch/data" "$scratch/empty"
env -u NOTIFY_SOCKET \
    XDG_RUNTIME_DIR="$scratch/runtime" \
    XDG_CONFIG_HOME="$scratch/config" XDG_DATA_HOME="$scratch/data" \
    XDG_CONFIG_DIRS="$scratch/empty" XDG_DATA_DIRS="$scratch/empty" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=$scratch/no-session-bus" \
    DBUS_SYSTEM_BUS_ADDRESS="unix:path=$scratch/no-system-bus" \
    SYSTEMD_UNIT_PATH=/usr/local/lib/systemd/user:/usr/lib/systemd/user \
    SYSTEMD_ENVIRONMENT_GENERATOR_PATH="$scratch/empty" \
    SYSTEMD_GENERATOR_PATH="$scratch/empty" \
    timeout --kill-after=2s 30s systemd-analyze --user --generators=no verify "$@"
