#!/usr/bin/env bash
# Run as the login user; sudo authenticates locally for installation and checks.
set -euo pipefail
repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
: "${WAN_INTERFACE:?Set WAN_INTERFACE to the phone network interface}"
: "${PHONE_SERIAL:?Set PHONE_SERIAL to the authorized USB phone}"
adb_bin=${ADB_BIN:-/usr/local/bin/adb}
[[ "$WAN_INTERFACE" =~ ^[a-zA-Z0-9._:-]+$ && "$PHONE_SERIAL" =~ ^[a-zA-Z0-9._:-]+$ ]] || exit 1
[[ "$adb_bin" =~ ^/[a-zA-Z0-9/._-]+$ && -x "$adb_bin" ]] || exit 1
login_user=$(id -un)
[[ "$login_user" =~ ^[a-zA-Z0-9_.-]+$ && "$HOME" =~ ^/[a-zA-Z0-9/._-]+$ ]] || exit 1
group=$(id -gn)
[[ "$group" =~ ^[a-zA-Z0-9_.-]+$ ]] || exit 1
ready_units=${READY_UNITS:-NetworkManager.service pc101-technitium.service}
read -r -a units <<< "$ready_units"
for unit in "${units[@]}"; do [[ "$unit" =~ ^[a-zA-Z0-9_.@:-]+\.service$ ]] || exit 1; done
substate=$(systemctl show adb-wan-recover.service -p SubState --value)
case "$substate" in start*|running|stop*) printf 'Service is busy; wait for it to finish.\n' >&2; exit 1 ;; esac
scratch=$(mktemp -d)
trap 'rm -rf -- "$scratch"' EXIT
printf 'WAN_INTERFACE=%s\nPHONE_SERIAL=%s\nREADY_UNITS="%s"\nUSB_CYCLE_ENABLED=0\nADB_BIN=%s\nADB_SERVER_PORT=5038\nADB_LIBUSB=1\nUSB_FUNCTION=rndis\n' \
    "$WAN_INTERFACE" "$PHONE_SERIAL" "$ready_units" "$adb_bin" > "$scratch/boot.env"
service=$(<"$repo/systemd/system/adb-wan-recover.service")
service=${service//Group=dave/Group=$group}
printf '%s\n' "$service" > "$scratch/adb-wan-recover.service"
server=$(<"$repo/systemd/system/adb-wan-server.service")
server=${server//User=dave/User=$login_user}
server=${server//Environment=HOME=\/home\/dave/Environment=HOME=$HOME}
printf '%s\n' "$server" > "$scratch/adb-wan-server.service"
if ! getent group adbwan >/dev/null; then sudo groupadd --system adbwan; fi
sudo install -m644 -o root -g root "$repo/udev/70-adb-wan.rules" /etc/udev/rules.d/70-adb-wan.rules
sudo udevadm control --reload-rules
sudo install -m755 -o root -g root "$repo/bin/adb-wan-boot" "$repo/bin/adb-wan-test" /usr/local/bin/
sudo install -d -m755 -o root -g root /etc/adb-ethernet-control
sudo install -m640 -o root -g "$group" "$scratch/boot.env" /etc/adb-ethernet-control/boot.env
sudo install -m644 -o root -g root "$scratch/adb-wan-recover.service" /etc/systemd/system/adb-wan-recover.service
sudo install -m644 -o root -g root "$scratch/adb-wan-server.service" /etc/systemd/system/adb-wan-server.service
if command -v restorecon >/dev/null; then
    sudo restorecon -F /usr/local/bin/adb-wan-boot /usr/local/bin/adb-wan-test \
        /etc/adb-ethernet-control/boot.env /etc/systemd/system/adb-wan-recover.service \
        /etc/systemd/system/adb-wan-server.service /etc/udev/rules.d/70-adb-wan.rules
fi
sudo systemd-analyze verify /etc/systemd/system/adb-wan-recover.service
sudo systemctl daemon-reload
sudo systemctl restart adb-wan-recover.service
sudo systemctl enable adb-wan-recover.service
systemctl is-enabled adb-wan-recover.service
systemctl show adb-wan-recover.service -p ActiveState -p SubState -p Result -p ExecMainStatus
journalctl -u adb-wan-recover.service -n 10 --no-pager
printf 'Installed, enabled, and checked. Boot records: /var/log/adb-wan-boot/run-*/result\n'
printf 'No reboot was performed.\n'
printf 'USB enable-only recovery installed. Cycling remains disabled until independent restoration is verified.\n'
printf 'Headless USB access rules apply on the next device enumeration; existing ADB authorization is required.\n'
