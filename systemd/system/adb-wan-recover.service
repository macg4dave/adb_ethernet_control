[Unit]
Description=Check and restore phone USB Ethernet after startup
Wants=network-online.target
Requires=NetworkManager.service
After=network-online.target NetworkManager.service

[Service]
Type=oneshot
User=root
Group=dave
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=/etc/adb-ethernet-control/boot.env
LogsDirectory=adb-wan-boot
LogsDirectoryMode=0750
Environment=TEST_LOG_ROOT=/var/log/adb-wan-boot
Environment=TEST_SHARED_LOGS=1
RuntimeDirectory=adb-wan-recover
RuntimeDirectoryMode=0700
Environment=LOCK_FILE=/run/adb-wan-recover/recovery.lock
ExecStart=/usr/local/bin/adb-wan-test --boot
TimeoutStartSec=15min
RemainAfterExit=true
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
