[Unit]
Description=Local phone WAN test (%i), independent of chat connectivity
Requires=adb-wan-server.service
After=adb-wan-server.service NetworkManager.service

[Service]
Type=oneshot
User=dave
SupplementaryGroups=adbwan
Environment=HOME=/home/dave
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=/etc/adb-ethernet-control/wan-recovery.env
LogsDirectory=adb-wan-test
LogsDirectoryMode=0700
Environment=TEST_LOG_ROOT=/var/log/adb-wan-test
RuntimeDirectory=adb-wan-recover
RuntimeDirectoryMode=0700
Environment=LOCK_FILE=/run/adb-wan-recover/recovery.lock
ExecStart=/usr/local/bin/adb-wan-test --%i
TimeoutStartSec=15min
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
